# Copy to .env and change the values. .env is not committed.
MYSQL_ROOT_PASSWORD=change_me_root
# port on your PC for MySQL tools (Workbench); containers always use mysql:3306
MYSQL_HOST_PORT=3307

# Application database user (created by db/init.sql)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=marketplace
DB_USER=marketplace
DB_PASSWORD=change_me_app
